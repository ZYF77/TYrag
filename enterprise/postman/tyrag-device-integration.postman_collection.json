                  "pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/(pdf|octet-stream)/i);"
                ]
              }
            }
          ]
        },
        {
          "name": "JWT v2 · invalid JWT",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{invalidJwt}}", "type": "string" } ] },
            "body": {
              "mode": "raw",
              "raw": "{\"equipmentId\":\"{{equipmentId}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/enterprise/api/v2/conversations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('invalid JWT is rejected', function () { pm.expect(pm.response.code).to.eql(401); });",
                  "pm.test('invalid JWT has a stable error code', function () { pm.expect(['AUTH_TOKEN_MISSING', 'AUTH_TOKEN_INVALID']).to.include(pm.response.json().code); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
