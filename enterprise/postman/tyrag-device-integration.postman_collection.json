{
  "info": {
    "_postman_id": "tyrag-device-integration",
    "name": "TYRAG device integration · FILE_SHARE v3 + query v2",
    "description": "P0 local device flow. Registration returns a slim 3.1.0 accept receipt (no statusUrl). Formal EAM integration uses the outbound terminal callback; this collection keeps a diagnostic GET status poll for local runner readiness before v2 queries.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "pageCount", "value": "1", "type": "string" },
    { "key": "questionOne", "value": "请根据已入库的设备文档，说明设备名称、固定资产号、文档类型和主要结论。", "type": "string" },
    { "key": "questionTwo", "value": "请继续说明同一设备资料中的关键日期、责任单位，以及检验、调试或验收结果。", "type": "string" }
  ],
  "item": [
    {
      "name": "FILE_SHARE v3 · HMAC",
      "description": "Service-to-service FILE_SHARE v3 requests. Set hmacSecret in Postman Vault for manual runs; Newman uses the ignored local environment.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(async function () {",
              "  function enc(value) { return encodeURIComponent(String(value)).replace(/[!'()*]/g, function (c) { return '%' + c.charCodeAt(0).toString(16).toUpperCase(); }); }",
              "  function dec(value) { return decodeURIComponent(String(value).replace(/\\+/g, ' ')); }",
              "  function canonicalPathQuery(path, query) {",
              "    var targetPath = enc(decodeURIComponent(path || '/')).replace(/%2F/gi, '/');",
              "    var pairs = []; String(query || '').split('&').forEach(function (part) { if (!part) return; var i = part.indexOf('='); var k = i < 0 ? part : part.slice(0, i); var v = i < 0 ? '' : part.slice(i + 1); pairs.push([enc(dec(k)), enc(dec(v))]); });",
              "    pairs.sort(function (a, b) { return a[0] === b[0] ? (a[1] < b[1] ? -1 : a[1] > b[1] ? 1 : 0) : (a[0] < b[0] ? -1 : 1); });",
              "    return pairs.length ? targetPath + '?' + pairs.map(function (pair) { return pair[0] + '=' + pair[1]; }).join('&') : targetPath;",
              "  }",
              "  function resolvedPathAndQuery() { var resolved = pm.variables.replaceIn(pm.request.url.toString()); var fragmentAt = resolved.indexOf('#'); if (fragmentAt >= 0) resolved = resolved.slice(0, fragmentAt); var schemeAt = resolved.indexOf('://'); var pathAt = schemeAt >= 0 ? resolved.indexOf('/', schemeAt + 3) : 0; var relative = pathAt >= 0 ? resolved.slice(pathAt) : '/'; var queryAt = relative.indexOf('?'); return { path: queryAt >= 0 ? relative.slice(0, queryAt) : relative, query: queryAt >= 0 ? relative.slice(queryAt + 1) : '' }; }",
              "  async function readSecret(name) { var value = ''; try { if (pm.vault && typeof pm.vault.get === 'function') value = await pm.vault.get(name); } catch (error) { value = ''; } return String(value || pm.variables.get(name) || ''); }",
              "  var keyId = String(pm.variables.get('keyId') || ''); var secret = await readSecret('hmacSecret'); if (!keyId || !secret) throw new Error('keyId and hmacSecret are required');",
              "  var configured = String(pm.variables.get('hmacTimestamp') || ''); var timestamp = /^\\d{10}$/.test(configured) ? configured : String(Math.floor(Date.now() / 1000)); if (!/^\\d{10}$/.test(timestamp)) throw new Error('timestamp must be a ten-digit epoch value');",
              "  var resolvedTarget = resolvedPathAndQuery(); var path = resolvedTarget.path; var query = resolvedTarget.query; var rawBody = pm.request.body && pm.request.body.mode === 'raw' ? pm.variables.replaceIn(pm.request.body.raw || '') : '';",
              "  var bodyHash = CryptoJS.SHA256(CryptoJS.enc.Utf8.parse(rawBody)).toString(CryptoJS.enc.Hex); var canonical = ['v1', timestamp, pm.request.method.toUpperCase(), canonicalPathQuery(path, query), bodyHash].join('\\n');",
              "  var digest = CryptoJS.HmacSHA256(canonical, secret).toString(CryptoJS.enc.Hex); pm.request.headers.upsert({ key: 'X-TY-Timestamp', value: timestamp }); pm.request.headers.upsert({ key: 'X-TY-Key-Id', value: keyId }); pm.request.headers.upsert({ key: 'X-TY-Signature', value: 'v1=' + digest });",
              "})();"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "FILE_SHARE v3 · register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\"eventId\":\"{{eventId}}\",\"eventType\":\"upsert\",\"externalDocumentId\":\"{{externalDocumentId}}\",\"fileName\":\"{{fileName}}\",\"mediaType\":\"application/pdf\",\"metadata\":{\"allow_group_ids\":[\"{{allowGroupId}}\"],\"business_status\":\"active\",\"department_id\":\"{{departmentId}}\",\"document_type\":\"{{documentType}}\",\"document_version\":\"{{sourceVersionId}}\",\"equipment_id\":\"{{equipmentId}}\",\"external_document_id\":\"{{externalDocumentId}}\",\"fixed_asset_no\":\"{{fixedAssetNo}}\",\"page_count\":{{pageCount}},\"schema_version\":1,\"security_level\":{{securityLevel}},\"source_system\":\"{{sourceSystem}}\",\"tenant_id\":\"{{tenantId}}\"},\"sha256\":\"{{fileSha256}}\",\"source\":{\"kind\":\"FILE_SHARE\",\"relativePath\":\"{{relativePath}}\",\"size\":{{fileSize}},\"storageRootId\":\"{{storageRootId}}\"},\"sourceVersionId\":\"{{sourceVersionId}}\",\"sourceSystem\":\"{{sourceSystem}}\",\"tenantId\":\"{{tenantId}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/enterprise/api/v3/documents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registration is accepted', function () { pm.expect(pm.response.code).to.eql(202); });",
                  "var payload = pm.response.json(); pm.test('registration returns slim accept receipt', function () { pm.expect(payload).to.have.keys('operationId', 'externalDocumentId', 'sourceVersionId', 'deduplicated', 'updatedAt'); pm.expect(payload).to.not.have.property('statusUrl'); });",
                  "pm.environment.set('operationId', payload.operationId || ''); pm.environment.set('statusUrl', '/enterprise/api/v3/documents/' + encodeURIComponent(pm.environment.get('externalDocumentId')) + '/status?tenantId=' + encodeURIComponent(pm.environment.get('tenantId')) + '&sourceSystem=' + encodeURIComponent(pm.environment.get('sourceSystem')) + '&sourceVersionId=' + encodeURIComponent(pm.environment.get('sourceVersionId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "FILE_SHARE v3 · duplicate register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\"eventId\":\"{{eventId}}\",\"eventType\":\"upsert\",\"externalDocumentId\":\"{{externalDocumentId}}\",\"fileName\":\"{{fileName}}\",\"mediaType\":\"application/pdf\",\"metadata\":{\"allow_group_ids\":[\"{{allowGroupId}}\"],\"business_status\":\"active\",\"department_id\":\"{{departmentId}}\",\"document_type\":\"{{documentType}}\",\"document_version\":\"{{sourceVersionId}}\",\"equipment_id\":\"{{equipmentId}}\",\"external_document_id\":\"{{externalDocumentId}}\",\"fixed_asset_no\":\"{{fixedAssetNo}}\",\"page_count\":{{pageCount}},\"schema_version\":1,\"security_level\":{{securityLevel}},\"source_system\":\"{{sourceSystem}}\",\"tenant_id\":\"{{tenantId}}\"},\"sha256\":\"{{fileSha256}}\",\"source\":{\"kind\":\"FILE_SHARE\",\"relativePath\":\"{{relativePath}}\",\"size\":{{fileSize}},\"storageRootId\":\"{{storageRootId}}\"},\"sourceVersionId\":\"{{sourceVersionId}}\",\"sourceSystem\":\"{{sourceSystem}}\",\"tenantId\":\"{{tenantId}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/enterprise/api/v3/documents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('duplicate registration is accepted', function () { pm.expect(pm.response.code).to.eql(202); });",
                  "pm.test('duplicate registration is marked deduplicated', function () { pm.expect(pm.response.json().deduplicated).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "FILE_SHARE v3 · poll diagnostic status",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "" },
            "url": "{{baseUrl}}{{statusUrl}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status response is successful', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "var payload = pm.response.json(); var attempt = Number(pm.environment.get('pollAttempt') || '0'); var maxAttempts = Number(pm.environment.get('maxPollAttempts') || '10');",
                  "pm.test('status belongs to the registered FILE_SHARE document', function () { pm.expect(payload.externalDocumentId).to.eql(pm.environment.get('externalDocumentId')); pm.expect(payload.sourceKind).to.eql('FILE_SHARE'); });",
                  "if (payload.retrievable === true) { pm.test('retrievable status contains completed parse and index facts', function () { pm.expect(payload.pipelineStatus).to.be.oneOf(['DONE', '3']); pm.expect(payload.parseCompleted).to.eql(true); pm.expect(payload.indexCompleted).to.eql(true); pm.expect(payload.qualityStatus).to.eql('passed'); pm.expect(payload.errorCode).to.eql(null); }); pm.environment.set('pollAttempt', '0'); } else { var nextAttempt = attempt + 1; pm.environment.set('pollAttempt', String(nextAttempt)); if (nextAttempt < maxAttempts) { pm.execution.setNextRequest('FILE_SHARE v3 · poll diagnostic status'); } else { pm.execution.setNextRequest(null); pm.expect.fail('FILE_SHARE document did not become retrievable within maxPollAttempts'); } }"
                ]
              }
            }
          ]
        },
        {
          "name": "FILE_SHARE v3 · invalid HMAC",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\"eventId\":\"{{invalidEventId}}\",\"eventType\":\"upsert\",\"externalDocumentId\":\"{{externalDocumentId}}\",\"fileName\":\"{{fileName}}\",\"mediaType\":\"application/pdf\",\"metadata\":{\"allow_group_ids\":[\"{{allowGroupId}}\"],\"business_status\":\"active\",\"department_id\":\"{{departmentId}}\",\"document_type\":\"{{documentType}}\",\"document_version\":\"{{sourceVersionId}}\",\"equipment_id\":\"{{equipmentId}}\",\"external_document_id\":\"{{externalDocumentId}}\",\"fixed_asset_no\":\"{{fixedAssetNo}}\",\"page_count\":{{pageCount}},\"schema_version\":1,\"security_level\":{{securityLevel}},\"source_system\":\"{{sourceSystem}}\",\"tenant_id\":\"{{tenantId}}\"},\"sha256\":\"{{fileSha256}}\",\"source\":{\"kind\":\"FILE_SHARE\",\"relativePath\":\"{{relativePath}}\",\"size\":{{fileSize}},\"storageRootId\":\"{{storageRootId}}\"},\"sourceVersionId\":\"{{sourceVersionId}}\",\"sourceSystem\":\"{{sourceSystem}}\",\"tenantId\":\"{{tenantId}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/enterprise/api/v3/documents"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [ "pm.request.headers.upsert({ key: 'X-TY-Signature', value: 'v1=' + '0'.repeat(64) });" ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('invalid HMAC is rejected', function () { pm.expect(pm.response.code).to.eql(401); });",
                  "pm.test('invalid HMAC has a stable error code', function () { pm.expect(pm.response.json().code).to.eql('AUTH_SIGNATURE_INVALID'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "FILE_SHARE v3 · missing source registration",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\"eventId\":\"{{missingEventId}}\",\"eventType\":\"upsert\",\"externalDocumentId\":\"{{missingExternalDocumentId}}\",\"fileName\":\"{{fileName}}\",\"mediaType\":\"application/pdf\",\"metadata\":{\"allow_group_ids\":[\"{{allowGroupId}}\"],\"business_status\":\"active\",\"department_id\":\"{{departmentId}}\",\"document_type\":\"{{documentType}}\",\"document_version\":\"{{sourceVersionId}}\",\"equipment_id\":\"{{equipmentId}}\",\"external_document_id\":\"{{missingExternalDocumentId}}\",\"fixed_asset_no\":\"{{fixedAssetNo}}\",\"page_count\":{{pageCount}},\"schema_version\":1,\"security_level\":{{securityLevel}},\"source_system\":\"{{sourceSystem}}\",\"tenant_id\":\"{{tenantId}}\"},\"sha256\":\"{{fileSha256}}\",\"source\":{\"kind\":\"FILE_SHARE\",\"relativePath\":\"{{missingRelativePath}}\",\"size\":{{fileSize}},\"storageRootId\":\"{{storageRootId}}\"},\"sourceVersionId\":\"{{sourceVersionId}}\",\"sourceSystem\":\"{{sourceSystem}}\",\"tenantId\":\"{{tenantId}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/enterprise/api/v3/documents"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing source registration is accepted for async processing', function () { pm.expect(pm.response.code).to.eql(202); });",
                  "var payload = pm.response.json(); if (payload.statusUrl) pm.environment.set('missingStatusUrl', payload.statusUrl);"
                ]
              }
            }
          ]
        },
        {
          "name": "FILE_SHARE v3 · missing document status error",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "" },
            "url": "{{baseUrl}}/enterprise/api/v3/documents/NOT-REGISTERED/status?tenantId={{tenantId}}&sourceSystem={{sourceSystem}}&sourceVersionId={{sourceVersionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing document is rejected', function () { pm.expect(pm.response.code).to.eql(404); });",
                  "pm.test('missing document has a stable error code', function () { pm.expect(pm.response.json().code).to.eql('DOCUMENT_NOT_FOUND'); });"
                ]
