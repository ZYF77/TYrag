            "header": [ { "key": "Accept", "value": "application/pdf" } ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{userJwt}}", "type": "string" } ] },
            "body": { "mode": "raw", "raw": "" },
            "url": "{{baseUrl}}/enterprise/api/v2/citations/{{citationId}}/source"
