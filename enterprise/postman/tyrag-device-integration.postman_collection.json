      ]
    },
    {
      "name": "JWT v2 · session and messages",
      "description": "Formal user flow. Bearer JWT is read from the userJwt variable; the local generator creates the Gateway HS256 test claim shape.",
      "item": [
        {
          "name": "JWT v2 · create session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{userJwt}}", "type": "string" } ] },
            "body": {
              "mode": "raw",
              "raw": "{\"equipmentId\":\"{{equipmentId}}\",\"fixedAssetNo\":\"{{fixedAssetNo}}\",\"faultCode\":\"{{faultCode}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/enterprise/api/v2/conversations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('session is created', function () { pm.expect(pm.response.code).to.eql(201); });",
                  "var payload = pm.response.json(); pm.expect(payload.conversationId).to.be.a('string'); pm.environment.set('conversationId', payload.conversationId);"
                ]
              }
            }
          ]
        },
        {
          "name": "JWT v2 · question round 1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{userJwt}}", "type": "string" } ] },
            "body": {
              "mode": "raw",
              "raw": "{\"clientMessageId\":\"{{messageIdOne}}\",\"question\":\"{{questionOne}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/enterprise/api/v2/conversations/{{conversationId}}/messages"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('question round 1 returns a run result', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "var payload = pm.response.json();",
                  "pm.test('question round 1 returns completed cited evidence', function () {",
                  "  pm.expect(payload.status).to.eql('已完成');",
                  "  pm.expect(payload.answer).to.be.a('string').and.not.empty;",
                  "  var answer = payload.answer.trim().toLowerCase();",
                  "  pm.expect(answer).not.to.include(\"i don't have enough information\");",
                  "  pm.expect(answer).not.to.include('未找到可靠依据');",
                  "  pm.expect(payload.citations).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(payload.citations[0].citationId).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('citationId', payload.citations[0].citationId);"
                ]
              }
            }
          ]
        },
        {
          "name": "JWT v2 · question round 2",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{userJwt}}", "type": "string" } ] },
            "body": {
              "mode": "raw",
              "raw": "{\"clientMessageId\":\"{{messageIdTwo}}\",\"question\":\"{{questionTwo}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/enterprise/api/v2/conversations/{{conversationId}}/messages"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('question round 2 returns a run result', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "var payload = pm.response.json();",
                  "pm.test('question round 2 returns completed cited evidence', function () {",
                  "  pm.expect(payload.status).to.eql('已完成');",
                  "  pm.expect(payload.answer).to.be.a('string').and.not.empty;",
                  "  var answer = payload.answer.trim().toLowerCase();",
                  "  pm.expect(answer).not.to.include(\"i don't have enough information\");",
                  "  pm.expect(answer).not.to.include('未找到可靠依据');",
                  "  pm.expect(payload.citations).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(payload.citations[0].citationId).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.environment.set('citationId', payload.citations[0].citationId);"
                ]
              }
            }
          ]
        },
        {
          "name": "JWT v2 · history",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{userJwt}}", "type": "string" } ] },
            "body": { "mode": "raw", "raw": "" },
            "url": "{{baseUrl}}/enterprise/api/v2/conversations/{{conversationId}}/messages?limit=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('history is readable', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('history preserves message status and citations independently', function () { var payload = pm.response.json(); pm.expect(payload.items).to.be.an('array'); payload.items.forEach(function (item) { pm.expect(['已完成', '无可靠依据', '失败']).to.include(item.status); pm.expect(item.citations).to.be.an('array'); }); });"
                ]
              }
            }
          ]
        },
        {
          "name": "JWT v2 · citation detail",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "auth": { "type": "bearer", "bearer": [ { "key": "token", "value": "{{userJwt}}", "type": "string" } ] },
            "body": { "mode": "raw", "raw": "" },
