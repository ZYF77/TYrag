# Copy this file to .env on the target host and replace every placeholder.
# Do not copy the development .env and do not commit the completed file.

COMPOSE_PROJECT_NAME=tyrag-production
RAGFLOW_IMAGE=tyrag/ragflow:v0.26.4-tyrag-053807f
ENTERPRISE_GATEWAY_IMAGE=tyrag/enterprise-gateway:v0.26.4
ENTERPRISE_WEB_IMAGE=tyrag/enterprise-web:v0.26.4
ELASTICSEARCH_IMAGE=elasticsearch:8.11.3
MYSQL_IMAGE=mysql:8.0.40
MINIO_IMAGE=pgsty/minio:RELEASE.2026-03-25T00-00-00Z
REDIS_IMAGE=valkey/valkey:8
ENTERPRISE_GATEWAY_POSTGRES_IMAGE=postgres:17.11-alpine3.24

STACK_VERSION=8.11.3
MEM_LIMIT=8073741824
TZ=Asia/Shanghai
DOC_ENGINE=elasticsearch
HF_ENDPOINT=https://hf-mirror.com

ELASTIC_PASSWORD=REPLACE_WITH_STRONG_ELASTIC_PASSWORD
ES_USER=elastic
ES_MEM_LIMIT=4g

MYSQL_DBNAME=rag_flow
MYSQL_USER=root
MYSQL_PASSWORD=REPLACE_WITH_STRONG_MYSQL_PASSWORD

MINIO_USER=REPLACE_WITH_MINIO_USER
MINIO_PASSWORD=REPLACE_WITH_STRONG_MINIO_PASSWORD
MINIO_BUCKET=ragflow

REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=volatile-lru
ENTERPRISE_REDIS_CONTAINER_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/1

# Independent PostgreSQL state store used only by Enterprise Gateway.
ENTERPRISE_GATEWAY_DB_NAME=tyrag_gateway
ENTERPRISE_GATEWAY_DB_USER=tyrag_gateway
ENTERPRISE_GATEWAY_DB_PASSWORD=REPLACE_WITH_STRONG_GATEWAY_DB_PASSWORD

# Linux host directories on the Gateway host (30). The file-share path is
# mounted read-only into the Gateway container. This is not the source path on
# the EAM server (31): if EAM stores files at
# /data/zk/EAM/attachments, mount that directory on 30 first and set this
# value to the resulting 30-side mount point.
ENTERPRISE_FILE_SHARE_HOST_ROOT=/srv/tyrag/file-share
ENTERPRISE_GATEWAY_STATE_HOST_DIR=/srv/tyrag/state

# Bind addresses default to loopback. Put TLS/reverse proxy in front before
# changing these to a non-loopback address.
RAGFLOW_BIND_ADDRESS=127.0.0.1
RAGFLOW_WEB_PORT=8080
RAGFLOW_HTTPS_PORT=8443
RAGFLOW_API_PORT=9380
RAGFLOW_ADMIN_PORT=9381
RAGFLOW_MCP_PORT=9382
RAGFLOW_GO_PORT=9384
RAGFLOW_GO_ADMIN_PORT=9383
ENTERPRISE_GATEWAY_BIND_ADDRESS=127.0.0.1
ENTERPRISE_GATEWAY_PORT=5188
ENTERPRISE_WEB_BIND_ADDRESS=127.0.0.1
ENTERPRISE_WEB_PORT=3000

# RAGFlow and Enterprise integration credentials.
RAGFLOW_API_KEY=REPLACE_WITH_RAGFLOW_API_KEY

# Optional EAM-owned read-only asset resolver. FILE_SHARE v3 ingestion does
# not require this endpoint. Configure it only when canonical asset lookup is
# enabled for a later query/validation flow.
ENTERPRISE_EAM_ASSET_RESOLVER_MODE=
ENTERPRISE_EAM_ASSET_RESOLVER_BASE_URL=
ENTERPRISE_EAM_ASSET_RESOLVER_PATH=/api/integration/v1/assets/resolve
ENTERPRISE_EAM_ASSET_RESOLVER_TOKEN=
ENTERPRISE_SYNC_HMAC_CREDENTIALS={"credentials":[{"credentialId":"replace-device-sync","keyId":"replace-key-id","secret":"replace-secret","allowedBindings":[{"tenantId":"replace-tenant","sourceSystem":"equipment-system"}]}]}

# Production end-user JWT validation (EAM issues RS256; Gateway only verifies).
# HS256 is intentionally disabled by the production Compose file.
# Do not place EAM private signing keys in Gateway env.
# Do not use a test overlay that clears JWT_JWKS_URL when EAM RS256 is live.
# Current EAM lab shape (replace hosts for other environments):
#   iss=http://192.168.30.31:5105
#   aud=tyrag-gateway
#   jwks=http://192.168.30.31:5105/.well-known/jwks.json
#   kid=eam-rs256-1  alg=RS256  ttl~15m  sub=EAM user id
# Missing ext_user_map rows are JIT-provisioned on first valid JWT.
JWT_ISSUER=http://192.168.30.31:5105
JWT_AUDIENCE=tyrag-gateway
JWT_JWKS_URL=http://192.168.30.31:5105/.well-known/jwks.json
JWT_ALLOWED_ALGS=RS256
# PyJWT default leeway is 0. .NET JsonWebTokenHandler sets nbf=now; allow
# issuer/gateway clock skew up to 120s (max 300 via the same env var).
JWT_LEEWAY_SECONDS=120

# Rolling summary for long inquiry conversations (transparent to EAM).
ENTERPRISE_CONTEXT_COMPRESS_ENABLED=true
ENTERPRISE_RAG_DIAGNOSTICS_ENABLED=false
ENTERPRISE_CONTEXT_COMPRESS_TURNS=20
ENTERPRISE_CONTEXT_SUMMARY_MAX_CHARS=1500
ENTERPRISE_CONTEXT_COMPRESS_KEEP_RECENT=4

# Empty name falls back to enterprise-{tenant_id} and creates a new RAGFlow
# dataset on first feed. Keep this aligned with the existing knowledge base.
ENTERPRISE_RAGFLOW_DATASET_NAME=设备问询知识库
ENTERPRISE_RAGFLOW_DATASET_PERMISSION=team
ENTERPRISE_QUERY_SOURCE_SYSTEM=EAM
ENTERPRISE_FILE_SHARE_MAX_SIZE_MB=512
ENTERPRISE_REPLAY_KEY_PREFIX=tyrag:production:service-replay:
ENTERPRISE_WORKER_ENABLED=true
ENTERPRISE_QUALITY_WORKER_ENABLED=true
ENTERPRISE_QUALITY_STRICT_MODE=true
# FILE_SHARE callback v1.0.0 (Gateway → EAM). Use the string URL form.
# Test: POST http://192.168.30.31:5105/api/v1/ai/feed/callback
# Do not put the outbound secret in Git. Do not reuse inbound v1= HMAC.
# ENTERPRISE_CALLBACK_ENABLED=true
# ENTERPRISE_CALLBACK_HMAC_SECRET=
# ENTERPRISE_CALLBACK_ENDPOINTS={"EAM":"http://192.168.30.31:5105/api/v1/ai/feed/callback"}
ENTERPRISE_CALLBACK_ENABLED=false
ENTERPRISE_CALLBACK_HMAC_SECRET=
ENTERPRISE_CALLBACK_ENDPOINTS=
ENTERPRISE_CALLBACK_MAX_ATTEMPTS=8
ENTERPRISE_CALLBACK_POLL_SECONDS=2.0
# Integration audit JSONL lives on the Gateway state volume, not the container layer.
# Host path: ${ENTERPRISE_GATEWAY_STATE_HOST_DIR}/logs
ENTERPRISE_AUDIT_LOG_DIR=/var/lib/tyrag/state/logs
LOG_LEVEL=INFO

# Business query remains disabled until the customer read-only adapter is
# wired and accepted against the real schema.
ENTERPRISE_BUSINESS_QUERY_ENABLED=false
ENTERPRISE_TIMESERIES_QUERY_ENABLED=false
